#!/usr/bin/env bash
# AI usage for the bar: Claude subscription windows and Neuralwatt energy and
# credits, read from the CodexBar CLI (`codexbar`, AUR codexbar-cli).
#
# Several ironbar labels call this script, so codexbar runs at most once per
# TTL and every label reads the shared cache. Anthropic's usage endpoint
# rate-limits hard, so the TTL counts from the last attempt, not the last
# success: a failed or rate-limited fetch also waits a full TTL.
set -euo pipefail

readonly TTL=300
cache_dir=${XDG_RUNTIME_DIR:-/tmp}
cache=$cache_dir/polar-ai-usage.json
stamp=$cache_dir/polar-ai-usage.stamp

# Nord. Pango markup sets the colours because a polled label cannot change
# its CSS class with the value.
readonly CALM="#d8dee9" WARN="#ebcb8b" CRIT="#bf616a"
# Positive tone for a pace verdict: Nord14, green like the Neuralwatt brand.
readonly GOOD="#a3be8c"
# Provider name colours, shared by the bar and the popup headers so each
# provider is recognisable at a glance: Nord12 orange for Claude, Nord14
# green for Neuralwatt.
readonly CLAUDE="#d08770" NEURALWATT="#a3be8c"

usage() {
  cat <<'EOF'
Usage: polar-ai-usage [label <provider>|num <provider> <used|elapsed>|popup|--help]

  label <provider>          one bar cell: the provider name dimmed, its
                            primary window value bright
                            (provider: claude | neuralwatt)
  num <provider> <which>    a bare 0..100 number for a progress rail:
                            `used` is the primary window share used,
                            `elapsed` is the share of that window elapsed
  popup                     the detail view: Claude windows, Neuralwatt energy
                            and credits, each with its share of the period
                            elapsed, the pace verdict and the projected use at
                            the reset

Data comes from `codexbar usage --format json`, which reports the providers
enabled in CodexBar's config (~/.config/codexbar/config.json). Enable claude
and neuralwatt there. codexbar runs at most once every 300 s; the result is
cached in $XDG_RUNTIME_DIR/polar-ai-usage.json.

POLAR_AI_USAGE_FIXTURE=<file.json> renders a saved codexbar JSON array
instead, without calling codexbar.
EOF
}

# Prints the codexbar JSON array, or nothing when no data is available.
load() {
  if [ -n "${POLAR_AI_USAGE_FIXTURE:-}" ]; then
    cat "$POLAR_AI_USAGE_FIXTURE"
    return
  fi
  command -v codexbar >/dev/null 2>&1 || return 0
  mkdir -p "$cache_dir"
  # The lock makes concurrent labels wait for one fetch instead of each
  # starting their own when the cache goes stale.
  exec 9>"$cache_dir/polar-ai-usage.lock"
  flock 9
  # A newer CodexBar config (a provider or key just set) skips the TTL wait.
  local config=${XDG_CONFIG_HOME:-$HOME/.config}/codexbar/config.json
  if [ -z "$(find "$stamp" -newermt "-$TTL seconds" 2>/dev/null)" ] || [ "$config" -nt "$stamp" ]; then
    touch "$stamp"
    local fresh
    # codexbar exits non-zero when any provider fails, but still prints the
    # array with a per-provider error, so the exit status is ignored.
    fresh=$(timeout 60 codexbar usage --format json 2>/dev/null) || true
    if jq -e 'type == "array"' >/dev/null 2>&1 <<<"$fresh"; then
      printf '%s\n' "$fresh" >"$cache.tmp"
      mv "$cache.tmp" "$cache"
    fi
  fi
  flock -u 9
  [ -r "$cache" ] && cat "$cache"
  return 0
}

render() { # mode, codexbar JSON, codexbar installed (yes|no), updated HH:MM
  # Empty or invalid input still renders: `-n` plus `try input` turns it into
  # an empty list, so every provider falls back to its placeholder.
  jq -nr --arg mode "$1" --arg installed "$3" --arg updated "$4" \
    --arg calm "$CALM" --arg warn "$WARN" --arg crit "$CRIT" --arg good "$GOOD" \
    --arg claude_c "$CLAUDE" --arg nw_c "$NEURALWATT" '
    def esc: gsub("&"; "&amp;") | gsub("<"; "&lt;") | gsub(">"; "&gt;");
    def pad($n): if length < $n then . + (" " * ($n - length)) else . end;
    def dim: "<span fgalpha=\"55%\">\(esc)</span>";
    def tone($p): if $p >= 90 then $crit elif $p >= 75 then $warn else $calm end;
    def pct: if . == null then null else (. + 0.5 | floor) end;
    # $n pads the plain text, so the popup columns stay aligned.
    def level($p; $n):
      if $p == null then "–" | pad($n) | dim
      else "<span foreground=\"\(tone($p))\">\("\($p)%" | pad($n))</span>" end;
    def when($fmt): try (sub("\\.[0-9]+Z$"; "Z") | fromdate | strflocaltime($fmt)) catch null;
    def money: "$" + ((. * 100 + 0.5 | floor) / 100 | tostring
      | if test("\\.") then (. + "0" | capture("(?<v>[0-9]*\\.[0-9]{2})").v) else . + ".00" end);
    def row($label; $w; $rest): "\($label | pad(16) | esc)\(level($w.usedPercent | pct; 6))\($rest // "" | dim)";
    def reset($w): ($w.resetsAt | if . then when("%a %H:%M") else null end) as $t
      | if $t then "resets \($t)" else null end;
    def line($label; $text): "\($label | pad(16) | esc)\($text | esc)";
    # Pace compares the share of the quota used with the share of the window
    # that has elapsed, so a window reads as under pace while the quota will
    # last to the reset and as over pace while it will run out early.
    def absv: if . < 0 then -. else . end;
    def epoch: try (sub("\\.[0-9]+Z$"; "Z") | fromdate) catch null;
    def elapsed($w):
      ($w.resetsAt | epoch) as $r
      | if $r == null or ($w.windowMinutes | type) != "number" then null
        else (($w.windowMinutes * 60) as $len
          | (($len - ($r - now)) / $len * 100
             | if . < 0 then 0 elif . > 100 then 100 else . end))
        end;
    def pace($w):
      elapsed($w) as $e
      | $w.usedPercent as $u
      | if $e == null or $u == null then null
        else ("\($e | pct)% through" | dim) as $through
          # A window just reset: a projection from under 2% of it is noise.
          | if ($e | pct) < 2 then $through
            else ($u - $e) as $d
              | ($d | absv | pct) as $mag
              | ($u / $e * 100 | pct) as $proj
              | $through + (" · " | dim)
                + (
                  if $d < -3 then "<span foreground=\"\($good)\">\($mag)% under pace</span>"
                  elif $d > 3 then
                    "<span foreground=\"\(if $proj > 100 then $crit else $warn end)\">\($mag)% over pace</span>"
                  else "<span foreground=\"\($calm)\">on pace</span>" end
                )
                + (" · " | dim)
                + "projects "
                + (if $proj > 100 then "<span foreground=\"\($crit)\">\($proj)%</span>"
                   else ("\($proj)%" | esc) end)
                + (" used" | dim)
            end
        end;
    def window($label; $w; $rest):
      row($label; $w; $rest),
      (pace($w) as $p | if $p then (" " * 16) + $p else empty end);

    (try input catch []) as $all
    | ($all | if type == "array" then . else [] end) as $all
    | ($all | map(select(.provider == "claude")) | first) as $claude
    | ($all | map(select(.provider == "neuralwatt")) | first) as $nw
    | $claude.usage as $cu | $nw.usage as $nu
    | ($mode | split(" ")) as $m
    | if $m[0] == "num" then
        # A rail value: a bare number, clamped, so a percent change never
        # moves the layout. A provider that has no window at all reads 0.
        (if $m[1] == "claude" then $cu.primary else $nu.primary end) as $w
        | (if $m[2] == "elapsed" then (elapsed($w) | pct) else ($w.usedPercent | pct) end)
        | if . == null then 0 else (if . < 0 then 0 elif . > 100 then 100 else . end) end
      elif $m[0] == "label" then
        # One bar cell. The name is the muted tier and the value the bright
        # one, so the island reads by value first. Nord13 and Nord11 keep the
        # warning the `bar` line already had.
        def dim($t): "<span fgalpha=\"60%\">\($t)</span>";
        def hot($v):
          if $v == null then "<span fgalpha=\"45%\">–</span>"
          else "<span foreground=\"\(if $v >= 90 then $crit elif $v >= 75 then $warn else "#eceff4" end)\" weight=\"bold\">\($v)%</span>"
          end;
        if $m[1] == "claude" then
          dim("Claude") + " " + hot($cu.primary.usedPercent | pct)
        else
          dim("Neuralwatt") + " "
          + (if ($nu.primary.usedPercent | pct) == null and $nu.providerCost != null
             then "<span foreground=\"#eceff4\" weight=\"bold\">\($nu.providerCost.used | money)</span>"
             else hot($nu.primary.usedPercent | pct)
             end)
        end
      else
        def header($name; $color; $p):
          "<span foreground=\"\($color)\" weight=\"bold\">\($name)</span>  "
          + ($p.usage.loginMethod // $p.usage.identity.loginMethod // "" | dim);
        def missing($p):
          if $installed == "no" then "Install codexbar-cli to see usage."
          elif $p == null then "Not enabled in CodexBar."
          else $p.error.message // "No data yet."
            | if length > 48 then .[:47] + "…" else . end
          end | dim;
        [
          header("Claude"; $claude_c; $claude),
          (if $cu == null then missing($claude)
           else
             (if $cu.primary then window(if $cu.primary.windowMinutes == 300 then "5-hour" else "Weekly" end; $cu.primary; reset($cu.primary)) else empty end),
             (if $cu.secondary and $cu.primary.windowMinutes == 300 then window("Weekly"; $cu.secondary; reset($cu.secondary)) else empty end),
             (if $cu.tertiary then window("\($claude.rateWindowLabels.tertiary // "Model") weekly"; $cu.tertiary; reset($cu.tertiary)) else empty end),
             ($cu.extraRateWindows // [] | .[] | window(.title; .window; reset(.window))),
             ($cu.providerCost // empty | line("Extra usage"; "\(.used | money) of \(.limit | money)"))
           end),
          "",
          header("Neuralwatt"; $nw_c; $nw),
          (if $nu == null then missing($nw)
           else
             (if $nu.primary then
                window("Energy"; $nu.primary; $nu.primary.resetDescription),
                ($nu.primary.resetsAt | if . then when("%a %d %b") else null end | values | line("Period ends"; .))
              else empty end),
             ($nu.providerCost // empty | line("Credits"; "\(.used | money) left")),
             ($nu.extraRateWindows // [] | .[] | window(.title; .window; null))
           end),
          (if $updated != "" then "", ("Updated \($updated)" | dim) else empty end)
        ] | join("\n")
      end
  ' <<<"$2"
}

case "${1:-}" in
popup) mode=popup ;;
label | num)
  case "${2:-}" in
  claude | neuralwatt) ;;
  *)
    printf 'polar-ai-usage: %s needs a provider: claude or neuralwatt\n' "$1" >&2
    usage >&2
    exit 2
    ;;
  esac
  mode="$1 $2"
  if [ "$1" = num ]; then
    case "${3:-used}" in
    used | elapsed) mode="$mode ${3:-used}" ;;
    *)
      printf 'polar-ai-usage: num takes used or elapsed, not %s\n' "$3" >&2
      usage >&2
      exit 2
      ;;
    esac
  fi
  ;;
-h | --help)
  usage
  exit 0
  ;;
*)
  printf 'polar-ai-usage: unknown argument: %s\n' "${1:-<none>}" >&2
  usage >&2
  exit 2
  ;;
esac

data=$(load)
installed=yes updated=""
if [ -z "${POLAR_AI_USAGE_FIXTURE:-}" ]; then
  command -v codexbar >/dev/null 2>&1 || installed=no
  updated=$(date -r "$cache" +%H:%M 2>/dev/null || :)
fi
render "$mode" "$data" "$installed" "$updated"
