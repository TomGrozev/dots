#!/usr/bin/env bash
# polar-wall — Nord wallpapers for the awww daemon.
# Wallpapers ship as SVGs and are rendered into the library at the monitor's
# pixel size, so every screen gets a native-resolution Nord image.
set -euo pipefail

WALL_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/polar/wallpapers"
SVG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/polar/wallpapers"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/polar"
STATE_FILE="$STATE_DIR/wallpaper"

die() {
  printf 'polar-wall: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
polar-wall — Nord wallpapers for awww

Usage:
  polar-wall next
  polar-wall set <image>
  polar-wall nordify <image>
  polar-wall restore

Commands:
  next             Render any new bundled wallpaper, then cycle to the next
                   one (fade, 0.8s).
  set <image>      Show an image (grow, 0.8s) and remember it.
  nordify <image>  Recolour an image with the Nord palette, keep it in
                   ~/.local/share/polar/wallpapers, and show it.
  restore          Render any new bundled wallpaper, then re-apply the last
                   wallpaper; cycles if none is known.

Bundled wallpapers are the SVGs in ${XDG_CONFIG_HOME:-~/.config}/polar/wallpapers;
they are rendered with resvg at the focused monitor's resolution into
${XDG_DATA_HOME:-~/.local/share}/polar/wallpapers.
The last applied image is remembered in ${XDG_STATE_HOME:-~/.local/state}/polar/wallpaper.
EOF
}

notify() {
  command -v notify-send >/dev/null 2>&1 && notify-send -a Polar -i image-x-generic "$1" "${2:-}" || true
}

# awww's transitions: grow for an explicit pick, fade for cycling/restore.
show() {
  local img="$1" type="$2" attempt=0
  [[ -f $img ]] || die "no such image: $img"
  # Autostart starts awww-daemon and `polar-wall restore` at the same time, so the
  # first frames can arrive before the daemon's socket exists. Retry for ~10s.
  until awww img --transition-type "$type" --transition-duration 0.8 --transition-fps 60 \
    --resize crop "$img" 2>/dev/null; do
    ((++attempt < 40)) || die "awww failed (is awww-daemon running?)"
    sleep 0.25
  done
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$img" >"$STATE_FILE"
}

nordify() {
  local src="$1" name out
  [[ -f $src ]] || die "no such image: $src"
  command -v lutgen >/dev/null 2>&1 ||
    die "lutgen not installed (AUR package: lutgen-bin)"

  mkdir -p "$WALL_DIR"
  name="$(basename "$src")"
  name="${name%.*}.png"
  out="$WALL_DIR/$name"
  if [[ ! -f $out ]]; then
    lutgen apply --palette nord --preserve -o "$out" "$src" ||
      die "lutgen failed on $src"
  fi
  show "$out" grow
  notify "Wallpaper nordified" "$(basename "$out")"
}

# Render at the focused monitor's pixel size. `restore` can run before the
# compositor answers, hence the 1080p fallback.
monitor_size() {
  local size
  size="$({ hyprctl monitors -j | jq -r 'first(.[] | select(.focused) | "\(.width) \(.height)")'; } 2>/dev/null)" || true
  if [[ $size =~ ^([0-9]+)\ ([0-9]+)$ ]]; then
    printf '%s %s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
  else
    printf '1920 1080\n'
  fi
}

# Bundled SVGs are the source of truth, the library holds their renders. Runs at
# login via `restore`, so it must stay cheap: resvg is only invoked for a PNG
# that is missing or older than its SVG.
sync_walls() {
  local svgs=() svg name png w h have_resvg=0
  mkdir -p "$WALL_DIR"
  # nullglob: with no bundled wallpapers the loop below must simply not run.
  shopt -s nullglob
  svgs=("$SVG_DIR"/*.svg)
  shopt -u nullglob

  if ((${#svgs[@]} == 0)) &&
    ! find "$WALL_DIR" -maxdepth 1 -type f \
      \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) \
      -print -quit | grep -q .; then
    die "no wallpapers: bundled SVGs go in $SVG_DIR, images in $WALL_DIR"
  fi
  ((${#svgs[@]})) || return 0

  read -r w h <<<"$(monitor_size)"
  command -v resvg >/dev/null 2>&1 && have_resvg=1

  for svg in "${svgs[@]}"; do
    name="$(basename "$svg" .svg)"
    png="$WALL_DIR/$name.png"
    if [[ -f $png && $png -nt $svg ]]; then
      continue
    fi
    ((have_resvg)) ||
      die "resvg not installed (package: resvg) — cannot render $svg"
    # Render beside the target, then move: an interrupted or failed render must
    # not leave a truncated PNG whose fresh mtime makes it look up to date.
    resvg -w "$w" -h "$h" "$svg" "$png.part" ||
      { rm -f "$png.part"; die "resvg failed on $svg"; }
    mv -f "$png.part" "$png"
  done
}

next() {
  sync_walls
  local walls=() i current
  while IFS= read -r wall; do
    walls+=("$wall")
  done < <(find "$WALL_DIR" -maxdepth 1 -type f \
    \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) | sort)
  ((${#walls[@]})) || die "no wallpapers in $WALL_DIR"

  current="$(cat "$STATE_FILE" 2>/dev/null || true)"
  for i in "${!walls[@]}"; do
    if [[ ${walls[$i]} == "$current" ]]; then
      show "${walls[$(((i + 1) % ${#walls[@]}))]}" fade
      return
    fi
  done
  show "${walls[0]}" fade
}

restore() {
  local last
  sync_walls
  last="$(cat "$STATE_FILE" 2>/dev/null || true)"
  if [[ -n $last && -f $last ]]; then
    show "$last" fade
  else
    next
  fi
}

case "${1:-}" in
--help | -h | help | "")
  usage
  ;;
next)
  next
  ;;
set)
  [[ $# -eq 2 ]] || die "usage: polar-wall set <image>"
  show "$(realpath -- "$2")" grow
  ;;
nordify)
  [[ $# -eq 2 ]] || die "usage: polar-wall nordify <image>"
  nordify "$(realpath -- "$2")"
  ;;
restore)
  restore
  ;;
*)
  die "unknown command: $1 (try --help)"
  ;;
esac
