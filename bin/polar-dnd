#!/usr/bin/env bash
# Toggle Noctalia's native do-not-disturb mode. The bar notification widget and
# polar-focus read the same state, so this script owns no state file.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: polar-dnd [--help]

Toggle notifications: Noctalia enters or exits Do Not Disturb, and its bar
widget shows the muted-bell indicator. Focus mode uses the same native state.
EOF
}

case "${1:-}" in
-h | --help)
  usage
  exit 0
  ;;
"") ;;
*)
  printf 'polar-dnd: unknown argument: %s\n' "$1" >&2
  usage >&2
  exit 2
  ;;
esac

if ! command -v noctalia >/dev/null 2>&1; then
  printf 'polar-dnd: noctalia is not installed\n' >&2
  exit 1
fi

noctalia msg notification-dnd-toggle
