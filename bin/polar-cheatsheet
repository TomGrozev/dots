#!/usr/bin/env bash
# Searchable cheat sheet. HyprCore writes cheatsheet.tsv on every config load;
# every row is a real action, so the list is the keymap, not a copy of it.
set -euo pipefail

cache_dir=${XDG_CACHE_HOME:-$HOME/.cache}/polar
tsv=$cache_dir/cheatsheet.tsv

usage() {
  cat <<'EOF'
Usage: polar-cheatsheet [--help]

Open the Polar cheat sheet in fuzzel: one row per action, grouped as
group │ chord │ description. Type to filter, Enter to run the action.

The list is generated by the Hyprland config (cheatsheet.tsv) when it loads.
If it is empty, reload Hyprland once and try again.

Keys: SUPER+/ opens this list.
EOF
}

notify() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send --app-name=Polar --icon=dialog-information "$@" 2>/dev/null || true
  else
    printf 'polar: %s\n' "$*" >&2
  fi
}

case "${1:-}" in
-h | --help)
  usage
  exit 0
  ;;
"") ;;
*)
  printf 'polar-cheatsheet: unknown argument: %s\n' "$1" >&2
  usage >&2
  exit 2
  ;;
esac

if [ ! -s "$tsv" ]; then
  notify "Cheat sheet not ready" "The Hyprland config has not loaded yet, so there is no key list. Reload Hyprland and try again."
  exit 1
fi

# Pad the group and chord columns so the list reads as a table; fuzzel shows
# only the first three fields and prints the command field when chosen.
rows=$(
  awk -F'\t' '
    NF >= 4 && $1 != "" && $2 != "" && $3 != "" {
      rows[++n] = $0
      if (length($1) > w1) w1 = length($1)
      if (length($2) > w2) w2 = length($2)
    }
    END {
      for (i = 1; i <= n; i++) {
        split(rows[i], f, "\t")
        printf "%-*s\t%-*s\t%s\t%s\n", w1, f[1], w2, f[2], f[3], f[4]
      }
    }
  ' "$tsv"
)

if [ -z "$rows" ]; then
  notify "Cheat sheet is empty" "No usable rows in $tsv. Reload Hyprland and try again."
  exit 1
fi

if ! selection=$(
  printf '%s\n' "$rows" |
    fuzzel --dmenu --prompt='keys › ' --match-mode=fuzzy --only-match \
      --no-run-if-empty --with-nth='{1} │ {2} │ {3}' --accept-nth=4
); then
  exit 0 # fuzzel reports a non-zero status on Escape
fi

[ -n "$selection" ] || exit 0

# Detach: the chosen action may be interactive and must outlive this picker.
setsid -f sh -c "$selection" >/dev/null 2>&1 &
