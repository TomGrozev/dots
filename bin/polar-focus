#!/usr/bin/env bash
# Focus mode: one window, no bar, no notifications, no dimming.
# Hyprland applies the visual side (Polar.set_state); the bar and DND are
# Noctalia surfaces, so they are driven through IPC.
set -euo pipefail

state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/polar
badge_dir="${XDG_RUNTIME_DIR:-/tmp}/polar/state"
dnd_before=$state_dir/dnd-before-focus

usage() {
  cat <<'EOF'
Usage: polar-focus [--help]

Toggle focus mode: gaps and border shrink to nothing, dimming stops, the bar
hides and notifications are muted. Run it again to restore everything.

State lives in the Hyprland config (Polar.set_state), in
$XDG_STATE_HOME/polar/ and in ${XDG_RUNTIME_DIR}/polar/state/focus, which the
Noctalia badges plugin reads. The DND state saved on entry is restored on exit.
EOF
}

state_get() {
  local value=false
  [ -r "$state_dir/focus" ] && value=$(cat "$state_dir/focus")
  printf '%s\n' "$value"
}

state_set() { # true|false
  mkdir -p "$state_dir" "$badge_dir"
  printf '%s\n' "$1" >"$state_dir/focus"
  printf '%s\n' "$1" >"$badge_dir/focus"
}

noctalia_msg() {
  command -v noctalia >/dev/null 2>&1 || return 0
  noctalia msg "$@" >/dev/null 2>&1 || true
}

case "${1:-}" in
-h | --help)
  usage
  exit 0
  ;;
"") ;;
*)
  printf 'polar-focus: unknown argument: %s\n' "$1" >&2
  usage >&2
  exit 2
  ;;
esac

if [ "$(state_get)" = true ]; then
  next=false
else
  next=true
fi

hyprctl eval "Polar.set_state('focus', $next)" >/dev/null 2>&1 || true

if [ "$next" = true ]; then
  mkdir -p "$state_dir"
  # Remember the user's own DND choice, so leaving focus mode does not clear
  # a setting they made before entering it.
  if command -v noctalia >/dev/null 2>&1; then
    noctalia msg notification-dnd-status >"$dnd_before" 2>/dev/null || true
  fi
  noctalia_msg bar-hide
  noctalia_msg notification-dnd-set on
else
  noctalia_msg bar-show
  if [ -r "$dnd_before" ]; then
    case $(cat "$dnd_before") in
    on) noctalia_msg notification-dnd-set on ;;
    off) noctalia_msg notification-dnd-set off ;;
    esac
    rm -f "$dnd_before"
  fi
fi

state_set "$next"
