{
  "keybind": "ctrl+r",
  "capture": {
    "type": "ffmpeg",
    "ffmpegPath": "ffmpeg",
    "inputFormat": "avfoundation",
    "input": ":0"
  },
  "provider": {
    "type": "soniox",
    "model": "stt-async-v5",
    "apiKeyEnv": "SONIOX_API_KEY",
    "language": "en",
    "pollIntervalMs": 1000
  }
}
