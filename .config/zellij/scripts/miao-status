#!/bin/sh
# Compact captain-miao tally for the zjstatus bottom bar:
#   #[fg=$nord11,bold]⚑ 2 #[fg=$nord13]▶ 3
# ⚑ counts sessions needing attention (waiting for approval/decision, review
# pending, failed to start), ▶ counts working ones (starting, active,
# compacting, background-active). Zero parts are dropped and nothing is
# printed when both are zero, so the widget vanishes. The `$nord*` names are
# resolved by zjstatus because the widget runs with rendermode dynamic.
set -u

sessions="${XDG_STATE_HOME:-$HOME/.local/state}/captain-miao/sessions"
[ -d "$sessions" ] || exit 0
command -v jq >/dev/null 2>&1 || exit 0

attn=0
work=0
for file in "$sessions"/*.json; do
    [ -f "$file" ] || continue
    # One jq per record; a malformed file just drops out of the tally.
    record="$(jq -r '[.launcher_pid // empty, .status // empty] | join(" ")' "$file" 2>/dev/null)"
    [ -n "$record" ] || continue
    pid="${record%% *}"
    # Records outlive their launcher, so skip the ones whose process is gone.
    [ -z "$pid" ] || kill -0 "$pid" 2>/dev/null || continue
    case "${record##* }" in
        waiting_for_approval | waiting_for_decision | review_pending | failed_to_start)
            attn=$((attn + 1))
            ;;
        starting | active | compacting | background_active)
            work=$((work + 1))
            ;;
    esac
done

out=""
[ "$attn" -gt 0 ] && out="#[fg=\$nord11,bold]⚑ $attn"
[ "$work" -gt 0 ] && out="${out:+$out }#[fg=\$nord13]▶ $work"
[ -n "$out" ] && printf '%s' "$out "
exit 0
