# Polar notifications: Nord, top-right, 8px corners.
# mako is the only notification daemon here (no SwayNC), so ironbar has no
# notifications module — popups are the whole notification surface.

font=FiraCode Nerd Font 11
# mako looks icons up in hicolor/pixmaps rather than the installed theme, so
# without this the icons the polar scripts pass never resolve; the cards are
# light, so Papirus (dark glyphs) is the readable choice.
icon-path=/usr/share/icons/Papirus
max-history=20
max-visible=5
sort=-time

width=360
height=180
margin=10
outer-margin=12,12
padding=10
border-size=2
border-radius=8
anchor=top-right
layer=overlay

background-color=#E5E9F0F5
text-color=#2E3440FF
border-color=#88C0D0FF

default-timeout=8000
ignore-timeout=0
markup=1
icons=1
max-icon-size=32
icon-border-radius=4

on-button-left=invoke-default-action
on-button-middle=dismiss
on-button-right=dismiss

# Urgency: frost for normal, muted slate for low, Aurora red for critical.
[urgency=low]
border-color=#4C566AFF
text-color=#4C566AFF
default-timeout=4000

[urgency=normal]
border-color=#88C0D0FF
default-timeout=8000

[urgency=critical]
border-color=#BF616AFF
background-color=#3B4252F5
text-color=#ECEFF4FF
default-timeout=0

# Do-not-disturb: hide everything except critical alerts.
[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb urgency=critical]
invisible=0

# Volume/mic OSD: compact top-centre popup, replaced on every key press by
# polar-volume. Progress bar carries the level; the border is dropped so the
# icon and bar stay the only decoration.
[app-name=polar-osd]
anchor=top-center
width=230
height=88
margin=8
# 32px clears the 24px ironbar plus its gap; horizontal margin keeps the pill
# off the screen edge.
outer-margin=32,10
padding=8,10
border-size=0
border-radius=8
progress-color=over #88C0D0FF
background-color=#E5E9F0F5
text-color=#2E3440FF
max-icon-size=26
icon-border-radius=0
default-timeout=1200

# Own key presses are feedback, not an alert: never hide the OSD in DND.
[mode=do-not-disturb app-name=polar-osd]
invisible=0
