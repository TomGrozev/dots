{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@plannotator/opencode@latest",
    "cc-safety-net",
    "envsitter-guard",
    "opencode-notify",
    "@cortexkit/opencode-magic-context@latest",
    "opentmux"
  ],
  "default_agent": "orchestrator",
  "model": "opencode-go/mimo-v2.5",
  "instructions": ["./AGENTS.md"],
  "mcp": {
    "hexdocs-mcp": {
      "enabled": true,
      "type": "local",
      "command": ["npx", "-y", "hexdocs-mcp@0.5.0"]
    },
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "gh_grep": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "searxng": {
      "type": "local",
      "command": ["npx", "-y", "@nitish-raj/searxng-mcp-bridge"],
      "environment": {
        "SEARXNG_INSTANCE_URL": "https://search.theg.house"
      }
    }
  },
  "permission": {
    "glob": "allow",
    "grep": "allow",
    "read": "allow",
    "list": "allow",
    "todowrite": "allow",
    "question": "allow",
    "task": "allow",
    "skill": "allow",
    "lsp": "allow",
    "webfetch": "deny",
    "context7_resolve-library-id": "deny",
    "context7_query-docs": "deny",
    "hexdocs-mcp_fetch": "deny",
    "hexdocs-mcp_search": "deny",
    "searxng_health_check": "deny",
    "searxng_search": "deny",
    "gh_grep_searchGitHub": "deny",
    "external_directory": {
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.aws/**": "deny",
      "~/.kube/**": "ask",
      "~/.docker/**": "deny",
      "/tmp/**": "allow"
    }
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "build": {
      "description": "Direct coding agent for implementation tasks",
      "model": "opencode-go/mimo-v2.5-pro",
      "mode": "primary",
      "permission": {
        "edit": "ask",
        "task": "allow",
        "bash": {
          "*": "ask",
          "*mix test*": "allow",
          "*mix compile*": "allow",
          "*mix format*": "allow",
          "*ls *": "allow",
          "*pwd*": "allow",
          "*echo *": "allow",
          "*cat *": "allow",
          "*head *": "allow",
          "*tail *": "allow",
          "*which *": "allow",
          "*find *": "allow",
          "*ps*": "allow",
          "*date*": "allow",
          "*whoami*": "allow",
          "*id*": "allow",
          "*uname*": "allow",
          "*cd *": "allow",
          "*pip list*": "allow",
          "*npm list*": "allow",
          "*brew list*": "allow",
          "*df*": "allow",
          "*du *": "allow",
          "*top*": "allow",
          "*htop*": "allow",
          "*git status*": "allow",
          "*git log*": "allow",
          "*git diff*": "allow",
          "*git branch*": "allow",
          "*git remote*": "allow",
          "*git config*": "allow",
          "*git rev-parse*": "allow",
          "*git show*": "allow",
          "*git ls-files*": "allow",
          "*python --version*": "allow",
          "*python3 --version*": "allow",
          "*node --version*": "allow",
          "*npm --version*": "allow",
          "*git add*": "ask",
          "*git commit*": "ask",
          "*git push*": "ask",
          "*git pull*": "ask",
          "*git fetch*": "ask",
          "*git merge*": "ask",
          "*git rebase*": "ask",
          "*git reset*": "ask",
          "*git checkout*": "ask",
          "*git clone*": "ask",
          "*rm*": "ask",
          "*mv*": "ask",
          "*cp*": "ask",
          "*mkdir*": "ask",
          "*touch*": "ask",
          "*chmod*": "ask",
          "*chown*": "ask",
          "*kill*": "ask",
          "*pkill*": "ask",
          "*curl*": "ask",
          "*wget*": "ask",
          "*ssh*": "ask",
          "*scp*": "ask",
          "*rsync*": "ask",
          "*docker*": "ask",
          "*kubectl*": "ask",
          "*pip install*": "ask",
          "*npm install*": "ask",
          "*npm run*": "ask",
          "*brew install*": "ask",
          "*make*": "ask",
          "*cmake*": "ask",
          "*cargo*": "ask",
          "*go build*": "ask",
          "*go run*": "ask",
          "*python*": "ask",
          "*python3*": "ask",
          "*node*": "ask"
        }
      }
    },
    "orchestrator": {
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": {
          "explorer": "allow",
          "bash-executor": "allow",
          "code-executor": "allow",
          "code-reviewer": "allow",
          "docs-reviewer": "allow",
