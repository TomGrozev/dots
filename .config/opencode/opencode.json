          "*head *": "allow",
          "*tail *": "allow",
          "*which *": "allow",
          "*find *": "allow",
          "*rg*": "allow",
          "*ps*": "allow",
          "*date*": "allow",
          "*whoami*": "allow",
          "*id*": "allow",
          "*uname*": "allow",
          "*cd *": "allow",
          "*pip list*": "allow",
