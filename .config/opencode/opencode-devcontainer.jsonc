{
  "$schema": "https://opencode.ai/config.json",

  // DELTA LAYER. This file is loaded via OPENCODE_CONFIG *in addition to*
  // ~/.config/opencode/opencode.json and deep-merged over it. It only names
  // the keys it changes; plugin/mcp/model/instructions are all inherited.
  //
  // Threat model in a devcontainer: rootless, and only /home/dev survives a
  // rebuild. Destructive local commands are cheap to recover from, so we trade
  // permission prompts away. What is NOT cheap is credential theft — the
  // tokens in /home/dev are the same real tokens as on the host. So:
  //   - actions inside the box  -> allow
  //   - credential material     -> deny, everywhere, no override
  //   - leaving the box (push)  -> still ask

  "permission": {

    // The container filesystem is disposable — stop asking about paths outside
    // the worktree. Credential directories stay denied (last match wins).
    "external_directory": {
      "/tmp/**": "allow",
      "/var/tmp/**": "allow",
      "/workspace/**": "allow",
      "/workspaces/**": "allow",
      "/home/dev/**": "allow",
      "/usr/**": "allow",
      "/etc/**": "allow",
      "/opt/**": "allow",
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.aws/**": "deny",
      "~/.azure/**": "deny",
      "~/.kube/**": "deny",
      "~/.docker/**": "deny",
      "~/.config/gcloud/**": "deny",
      "~/.config/gh/**": "deny",
      "~/.config/op/**": "deny",
      "~/.password-store/**": "deny",
      "~/.local/share/opencode/auth.json": "deny",
      "~/.config/opencode/auth.json": "deny",
      "~/.claude/.credentials.json": "deny",
      "/home/dev/.ssh/**": "deny",
      "/home/dev/.gnupg/**": "deny",
      "/home/dev/.aws/**": "deny",
      "/home/dev/.kube/**": "deny",
      "/home/dev/.docker/**": "deny",
      "/home/dev/.config/gh/**": "deny",
      "/home/dev/.config/gcloud/**": "deny",
      "/home/dev/.local/share/opencode/auth.json": "deny",
      "/home/dev/.config/opencode/auth.json": "deny",
      "/home/dev/.claude/.credentials.json": "deny",
    },
  },

  // NOTE: `permission.read` is NOT overridden anywhere in this file. The global
  // config's read deny-list (SSH keys, cloud creds, auth.json, *.pem, ...) is
  // inherited verbatim and applies to every agent in the container.

  "agent": {
    // --- Workers: broad bash + edit. The credential deny tail is repeated
    // verbatim on every block that introduces a `"*": "allow"` catch-all,
    // because permission rules resolve last-match-wins and a bare catch-all
    // would otherwise outrank the inherited denies. Do not "simplify" this
    // by deleting the tails. ---
    "build": {
      "permission": {
        "edit": "allow",
        "task": "allow",
        "bash": {
          "*": "allow",
          "git push *": "ask",
          "*.ssh/*": "deny",
          "*id_rsa*": "deny",
          "*id_ed25519*": "deny",
          "*id_ecdsa*": "deny",
          "*.gnupg*": "deny",
          "*.aws/*": "deny",
          "*gcloud/*": "deny",
          "*.kube/config*": "deny",
          "*.docker/config.json*": "deny",
          "*.netrc*": "deny",
          "*.git-credentials*": "deny",
          "*.npmrc*": "deny",
          "*.pypirc*": "deny",
          "*credentials*": "deny",
          "*auth.json*": "deny",
          "*gh/hosts.yml*": "deny",
          "*.pem*": "deny",
          "*.p12*": "deny",
          "*.pfx*": "deny",
        },
      },
    },
    "code-executor": {
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "allow",
          "git push *": "ask",
          "*.ssh/*": "deny",
          "*id_rsa*": "deny",
          "*id_ed25519*": "deny",
          "*id_ecdsa*": "deny",
          "*.gnupg*": "deny",
          "*.aws/*": "deny",
          "*gcloud/*": "deny",
          "*.kube/config*": "deny",
          "*.docker/config.json*": "deny",
          "*.netrc*": "deny",
          "*.git-credentials*": "deny",
          "*.npmrc*": "deny",
          "*.pypirc*": "deny",
          "*credentials*": "deny",
          "*auth.json*": "deny",
          "*gh/hosts.yml*": "deny",
          "*.pem*": "deny",
          "*.p12*": "deny",
          "*.pfx*": "deny",
        },
        "task": {
          "*": "deny",
          "explorer": "allow",
          "test-verifier": "allow",
          "api-docs-researcher": "allow",
        },
      },
    },
    "frontend-designer": {
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "allow",
          "git push *": "ask",
          "*.ssh/*": "deny",
          "*id_rsa*": "deny",
          "*id_ed25519*": "deny",
          "*id_ecdsa*": "deny",
          "*.gnupg*": "deny",
          "*.aws/*": "deny",
          "*gcloud/*": "deny",
          "*.kube/config*": "deny",
          "*.docker/config.json*": "deny",
          "*.netrc*": "deny",
          "*.git-credentials*": "deny",
          "*.npmrc*": "deny",
          "*.pypirc*": "deny",
          "*credentials*": "deny",
          "*auth.json*": "deny",
          "*gh/hosts.yml*": "deny",
          "*.pem*": "deny",
          "*.p12*": "deny",
          "*.pfx*": "deny",
        },
        "task": {
          "*": "deny",
          "explorer": "allow",
          "api-docs-researcher": "allow",
        },
      },
    },
    "bash-executor": {
      "permission": {
        "bash": {
          "*": "allow",
          "git push *": "ask",
          "*.ssh/*": "deny",
          "*id_rsa*": "deny",
          "*id_ed25519*": "deny",
          "*id_ecdsa*": "deny",
          "*.gnupg*": "deny",
          "*.aws/*": "deny",
          "*gcloud/*": "deny",
          "*.kube/config*": "deny",
          "*.docker/config.json*": "deny",
          "*.netrc*": "deny",
          "*.git-credentials*": "deny",
          "*.npmrc*": "deny",
          "*.pypirc*": "deny",
          "*credentials*": "deny",
          "*auth.json*": "deny",
          "*gh/hosts.yml*": "deny",
          "*.pem*": "deny",
          "*.p12*": "deny",
          "*.pfx*": "deny",
        },
      },
    },
    "test-verifier": {
      "permission": {
        "bash": {
          "*": "allow",
          "git push *": "ask",
          "*.ssh/*": "deny",
          "*id_rsa*": "deny",
          "*id_ed25519*": "deny",
          "*id_ecdsa*": "deny",
          "*.gnupg*": "deny",
          "*.aws/*": "deny",
          "*gcloud/*": "deny",
          "*.kube/config*": "deny",
          "*.docker/config.json*": "deny",
          "*.netrc*": "deny",
          "*.git-credentials*": "deny",
          "*.npmrc*": "deny",
          "*.pypirc*": "deny",
          "*credentials*": "deny",
          "*auth.json*": "deny",
          "*gh/hosts.yml*": "deny",
          "*.pem*": "deny",
          "*.p12*": "deny",
          "*.pfx*": "deny",
        },
      },
    },
    "explorer": {
      "permission": {
        "bash": {
          "git blame *": "allow",
          "stat *": "allow",
          "file *": "allow",
          "tree *": "allow",
          "*.ssh/*": "deny",
          "*id_rsa*": "deny",
          "*id_ed25519*": "deny",
          "*id_ecdsa*": "deny",
          "*.gnupg*": "deny",
          "*.aws/*": "deny",
          "*gcloud/*": "deny",
          "*.kube/config*": "deny",
          "*.docker/config.json*": "deny",
          "*.netrc*": "deny",
          "*.git-credentials*": "deny",
          "*.npmrc*": "deny",
          "*.pypirc*": "deny",
          "*credentials*": "deny",
          "*auth.json*": "deny",
          "*gh/hosts.yml*": "deny",
          "*.pem*": "deny",
          "*.p12*": "deny",
          "*.pfx*": "deny",
        },
      },
    },
    "docs-writer": {
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "allow",
          "git push *": "ask",
          "*.ssh/*": "deny",
          "*id_rsa*": "deny",
          "*id_ed25519*": "deny",
          "*id_ecdsa*": "deny",
          "*.gnupg*": "deny",
          "*.aws/*": "deny",
          "*gcloud/*": "deny",
          "*.kube/config*": "deny",
          "*.docker/config.json*": "deny",
          "*.netrc*": "deny",
          "*.git-credentials*": "deny",
          "*.npmrc*": "deny",
          "*.pypirc*": "deny",
          "*credentials*": "deny",
          "*auth.json*": "deny",
          "*gh/hosts.yml*": "deny",
          "*.pem*": "deny",
          "*.p12*": "deny",
          "*.pfx*": "deny",
        },
      },
    },

    // --- Read-only agents. They get an explicit read-only inspection
    // allowlist (rg, grep, find, cat, ls, head, tail, wc, sort, uniq, jq,
    // pwd, which, stat, file, tree) plus the git verbs below, each followed by its own
    // credential-deny tail since these are broad enough to match secret
    // paths (e.g. `cat *` matches `cat ~/.ssh/id_rsa`). Critically, they
    // still keep `edit: deny` from the global config — reviewers report,
    // they don't write.
    // No `"*": "allow"` catch-all here, so the inherited credential denies
    // are never at risk of being outranked. ---
    // Specific verbs, not `git *` — a bare `git *` allow would append after the
    // inherited credential denies and let `git config --file ~/.git-credentials`
    // through.
    "code-reviewer": {
      "permission": {
        "bash": {
          "git diff *": "allow",
          "git log *": "allow",
          "git show *": "allow",
          "git status *": "allow",
          "git blame *": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "find *": "allow",
          "cat *": "allow",
          "ls *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow",
          "sort *": "allow",
          "uniq *": "allow",
          "jq *": "allow",
          "pwd": "allow",
          "which *": "allow",
          "stat *": "allow",
          "file *": "allow",
          "tree *": "allow",
          "*.ssh/*": "deny",
          "*id_rsa*": "deny",
          "*id_ed25519*": "deny",
          "*id_ecdsa*": "deny",
          "*.gnupg*": "deny",
          "*.aws/*": "deny",
          "*gcloud/*": "deny",
          "*.kube/config*": "deny",
          "*.docker/config.json*": "deny",
          "*.netrc*": "deny",
          "*.git-credentials*": "deny",
          "*.npmrc*": "deny",
          "*.pypirc*": "deny",
          "*credentials*": "deny",
          "*auth.json*": "deny",
          "*gh/hosts.yml*": "deny",
          "*.pem*": "deny",
          "*.p12*": "deny",
          "*.pfx*": "deny",
        },
      },
    },
    "security-reviewer": {
      "permission": {
        "bash": {
          "git diff *": "allow",
          "git log *": "allow",
          "git show *": "allow",
          "git status *": "allow",
          "git blame *": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "find *": "allow",
          "cat *": "allow",
          "ls *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow",
          "sort *": "allow",
          "uniq *": "allow",
          "jq *": "allow",
          "pwd": "allow",
          "which *": "allow",
          "stat *": "allow",
          "file *": "allow",
          "tree *": "allow",
          "*.ssh/*": "deny",
          "*id_rsa*": "deny",
          "*id_ed25519*": "deny",
          "*id_ecdsa*": "deny",
          "*.gnupg*": "deny",
          "*.aws/*": "deny",
          "*gcloud/*": "deny",
          "*.kube/config*": "deny",
          "*.docker/config.json*": "deny",
          "*.netrc*": "deny",
          "*.git-credentials*": "deny",
          "*.npmrc*": "deny",
          "*.pypirc*": "deny",
          "*credentials*": "deny",
          "*auth.json*": "deny",
          "*gh/hosts.yml*": "deny",
          "*.pem*": "deny",
          "*.p12*": "deny",
          "*.pfx*": "deny",
        },
      },
    },
    "docs-reviewer": {
      "permission": {
        "bash": {
          "git diff *": "allow",
          "git log *": "allow",
          "git show *": "allow",
          "git status *": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "find *": "allow",
          "cat *": "allow",
          "ls *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow",
          "sort *": "allow",
          "uniq *": "allow",
          "jq *": "allow",
          "pwd": "allow",
          "which *": "allow",
          "stat *": "allow",
          "file *": "allow",
          "tree *": "allow",
          "*.ssh/*": "deny",
          "*id_rsa*": "deny",
          "*id_ed25519*": "deny",
          "*id_ecdsa*": "deny",
          "*.gnupg*": "deny",
          "*.aws/*": "deny",
          "*gcloud/*": "deny",
          "*.kube/config*": "deny",
          "*.docker/config.json*": "deny",
          "*.netrc*": "deny",
          "*.git-credentials*": "deny",
          "*.npmrc*": "deny",
          "*.pypirc*": "deny",
          "*credentials*": "deny",
          "*auth.json*": "deny",
          "*gh/hosts.yml*": "deny",
          "*.pem*": "deny",
          "*.p12*": "deny",
          "*.pfx*": "deny",
        },
      },
    },

    // Web/MCP permissions are intentionally inherited — the global config
    // denies by default and grants only to code-reviewer, security-reviewer,
    // docs-reviewer, and api-docs-researcher. Do NOT re-add a top-level flip.

  },
}
